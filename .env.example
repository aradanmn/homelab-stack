# Site settings: addresses and the domain. Not secret, but they describe the
# network, so the real file is not committed. Copy this to .env and fill it
# in; scripts/homelab-stack.service passes it to docker compose together
# with the secrets file. Every value is required: the deploy stops with an
# error when one is missing.

# Base domain. Services answer on <name>.<DOMAIN>; the wildcard certificate
# is requested for *.<DOMAIN>.
DOMAIN=home.example.com

# Contact address for the Let's Encrypt account.
ACME_EMAIL=admin@example.com

# Backends that are not containers in this stack (rules/routers.yml).
UNIFI_URL=https://192.0.2.1
BLUEMAP_URL=http://192.0.2.10:8100
SCRYPTED_URL=https://192.0.2.107:10443
NAS_URL=http://192.0.2.40:9999
HA_URL=http://192.0.2.20:8123

# The second AdGuard Home copy that adguard-sync keeps identical.
ADGUARD_REPLICA_URL=http://192.0.2.20:3000

# --- Secrets: NOT set here on the live host ---
# CF_DNS_API_TOKEN (Cloudflare token with DNS edit on the zone, for the
# certificate's DNS-01 challenge) comes from /run/homelab-stack/env, written
# by scripts/homelab-stack-secrets.service. For a quick trial without that
# service, it can be set in .env instead.
# CF_DNS_API_TOKEN=
