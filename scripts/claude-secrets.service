# Fetches the claude user's secrets from BWS into the tmpfs at
# /home/claude/.secrets on LXC 105 before anything that reads them starts
# (claude_sessions#24 step 4b, option B). One bootstrap secret on disk:
#   install -d -m 0700 /etc/claude-secrets
#   systemd-creds encrypt --name=bws-token - /etc/claude-secrets/bws-token.cred   (paste the `claude` machine-account token, Enter, Ctrl-D; root shell)
#   chmod 0600 /etc/claude-secrets/bws-token.cred
# Fallback: /var/lib/claude-secrets/bundle.cred, written by each good fetch.
# docker.service is ordered after this unit through
# docker.service.d/claude-secrets.conf (any container that bind-mounts these
# files must not start before the tmpfs is populated). Re-fetch after a vault edit:
#   systemctl restart claude-secrets.service
[Unit]
Description=claude-secrets: fetch the claude user's secrets from BWS into /home/claude/.secrets (tmpfs, encrypted fallback)
After=network-online.target home-claude-.secrets.mount
Wants=network-online.target
Requires=home-claude-.secrets.mount
Before=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
User=root
LoadCredentialEncrypted=bws-token:/etc/claude-secrets/bws-token.cred
Environment=TZ=America/Chicago
# bws keeps a small auth state file under $HOME; keep it on tmpfs, root-only
Environment=HOME=/run/claude-secrets
ExecStart=/usr/local/lib/claude-secrets/fetch_secrets.sh
RuntimeDirectory=claude-secrets
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
StateDirectory=claude-secrets
StateDirectoryMode=0700
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
# the unit sees nothing of /home except the secrets tmpfs
ProtectHome=tmpfs
BindPaths=/home/claude/.secrets
ReadWritePaths=/home/claude/.secrets /var/lib/claude-secrets /run/claude-secrets

[Install]
WantedBy=multi-user.target
