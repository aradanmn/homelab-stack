# Fetches the stack's secrets from BWS into /run/homelab-stack before Docker
# starts (claude_sessions#24 option B). One bootstrap secret on disk:
#   systemd-creds encrypt --name=bws-token - /etc/homelab-stack/bws-token.cred   (paste token, Enter, Ctrl-D; root shell)
#   chmod 0600 /etc/homelab-stack/bws-token.cred
# Fallback: /var/lib/homelab-stack/bundle.cred, written by each good fetch.
[Unit]
Description=homelab-stack: fetch secrets from BWS into tmpfs (encrypted fallback)
After=network-online.target
Wants=network-online.target
Before=docker.service homelab-stack.service

[Service]
Type=oneshot
RemainAfterExit=yes
User=root
LoadCredentialEncrypted=bws-token:/etc/homelab-stack/bws-token.cred
Environment=TZ=America/Chicago
Environment=HOME=/run/homelab-stack
ExecStart=/usr/local/lib/homelab-stack/fetch_secrets.sh
RuntimeDirectory=homelab-stack
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
StateDirectory=homelab-stack
StateDirectoryMode=0700
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/run/homelab-stack /var/lib/homelab-stack

[Install]
WantedBy=multi-user.target
