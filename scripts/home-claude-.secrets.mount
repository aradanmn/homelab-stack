# tmpfs over /home/claude/.secrets on LXC 105, populated at boot by
# claude-secrets.service (claude_sessions#24 step 4b). A .mount unit rather
# than a mount from ExecStartPre=: PID 1 performs it in the host namespace
# (a service with ProtectSystem/ProtectHome mounts into its own private
# namespace only) and it cannot stack or wipe files on a re-run.
# Unit name = `systemd-escape --path /home/claude/.secrets`.
# While it is mounted the on-disk files underneath are hidden, not deleted;
# see README "Secrets from BWS at runtime" for how step C removes them.
[Unit]
Description=claude-secrets: tmpfs for /home/claude/.secrets (populated by claude-secrets.service)
Before=claude-secrets.service

[Mount]
What=tmpfs
Where=/home/claude/.secrets
Type=tmpfs
# claude is uid/gid 1000 on LXC 105; tmpfs takes numeric ids only
Options=size=1m,mode=0700,uid=1000,gid=1000,nosuid,nodev,noexec

[Install]
WantedBy=multi-user.target
